<UserControl x:Class="HardwareMonitor.DiskTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White">
    <StackPanel Margin="10">
        <TextBlock Text="Disk Hız Testi ve Sağlık Durumu" Foreground="#FF40E0D0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <GroupBox Header="Disk Durumu" BorderBrush="Orange" Foreground="White">
            <StackPanel Margin="10">
                <TextBlock x:Name="TxtDiskHealth" Text="Sağlık: %--" Foreground="Lime" FontSize="16" FontWeight="Bold"/>
               
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Anlık Aktivite" BorderBrush="Cyan" Foreground="White" Margin="0,10,0,0">
            <StackPanel Margin="10">
                <TextBlock x:Name="TxtLiveSpeed" Text="Okuma: 0 MB/s | Yazma: 0 MB/s" Foreground="Cyan"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Hız Testi" BorderBrush="Yellow" Foreground="White" Margin="0,10,0,0">
            <StackPanel Margin="10">
                <Button x:Name="BtnStartTest" Content="TESTİ BAŞLAT" Click="BtnStartTest_Click" Background="#222" Foreground="White" Height="30"/>
                <ProgressBar x:Name="PbTestProgress" Height="10" Margin="0,10" Maximum="100"/>
                <TextBlock x:Name="TxtTestResult" Text="Sonuç: --" HorizontalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>