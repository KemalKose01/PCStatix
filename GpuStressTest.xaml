<UserControl x:Class="HardwareMonitor.GpuStressTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,30,0,10" Padding="10">
            <StackPanel>
                <TextBlock Text="GPU STRESS TEST" Foreground="#e74c3c" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#e74c3c" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="40,0">
            <Border Background="#1e1e1e" CornerRadius="15" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="SICAKLIK" Foreground="#95a5a6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtCurrentTemp" Text="--°C" FontSize="42" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#333" Margin="20,5"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="GPU YÜKÜ" Foreground="#95a5a6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtCurrentLoad" Text="%0" FontSize="42" Foreground="#e74c3c" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="40,0,40,40">
            <Grid Margin="0,0,0,15">
                <TextBlock Text="İlerleme" Foreground="#7f8c8d" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="TxtTimer" Text="60s" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <ProgressBar x:Name="TestProgressBar" Height="8" Minimum="0" Maximum="60" BorderThickness="0" Background="#333" Foreground="#e74c3c">
                <ProgressBar.Clip>
                    <RectangleGeometry Rect="0,0,520,8" RadiusX="4" RadiusY="4"/>
                </ProgressBar.Clip>
            </ProgressBar>

            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnStart" Grid.Column="0" Content="TESTİ BAŞLAT" Click="BtnStart_Click" Height="45" Background="#27ae60" Style="{StaticResource ModernButton}"/>
                <Button x:Name="BtnStop" Grid.Column="2" Content="TESTİ DURDUR" Click="BtnStop_Click" Height="45" Background="#c0392b" IsEnabled="False" Style="{StaticResource ModernButton}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
