<UserControl x:Class="HardwareMonitor.GpuStressTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#121212">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GPU Stres Testi" Foreground="#FF7CFC00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Border Background="#1e1e1e" CornerRadius="10" Padding="20" Margin="40,20">
                <StackPanel>
                    <TextBlock x:Name="TxtCurrentTemp" Text="--°C" FontSize="56" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCurrentLoad" Text="Yük: %0" FontSize="24" Foreground="#95a5a6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="TestProgressBar" Width="300" Height="10" Minimum="0" Maximum="60" Foreground="#e74c3c" Background="#333" BorderThickness="0"/>
            <TextBlock x:Name="TxtTimer" Text="60s" Foreground="White" HorizontalAlignment="Center" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button x:Name="BtnStart" Content="Testi Başlat" Width="120" Height="40" Click="BtnStart_Click" Background="#27ae60" Foreground="White"/>
                <Button x:Name="BtnStop" Content="Testi Durdur" Width="120" Height="40" Click="BtnStop_Click" IsEnabled="False" Margin="10,0,0,0" Background="#c0392b" Foreground="White"/>
            </StackPanel>

            <Border x:Name="GpuResultCard" Visibility="Collapsed" Background="#332ecc71" CornerRadius="8" Padding="15" Margin="40,10" BorderBrush="#2ecc71" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TEST RAPORU" Foreground="#2ecc71" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtGpuFinalResult" Text="Maksimum Sıcaklık: -- | Maksimum Kullanım Oranı: %--" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

