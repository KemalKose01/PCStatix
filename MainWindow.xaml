<Window x:Class="HardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HardwareMonitor"
        Title="Hardware Monitor" Width="460" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="#80121212">

    <Border CornerRadius="12" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Grid>
            <Grid Background="#101010" Height="32" VerticalAlignment="Top" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock Text="PCStatix" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Cyan" FontWeight="Bold"/>
                <Button Content="X" Width="30" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Click="Close_Click"/>
            </Grid>

            <ScrollViewer Margin="0,32,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="Bilgi Ekranı">
                            <StackPanel Margin="5">
                                <GroupBox Header="İşlemci (CPU)" BorderBrush="Cyan" Foreground="White">
                                    <StackPanel Margin="10">
                                        <TextBlock x:Name="TxtCpuName" Foreground="Yellow" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCpuTemp" Foreground="OrangeRed" Margin="0,5,0,5" FontSize="14"/>

                                        <ItemsControl x:Name="IcCpuCores">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                        <TextBlock Text="{Binding Load}" Foreground="Lime" Grid.Column="1" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Clock}" Foreground="Cyan" Grid.Column="2" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Harici GPU (dGPU)" BorderBrush="Lime" Foreground="White" Margin="0,10,0,0">
                                    <StackPanel Margin="10">
                                        <TextBlock x:Name="TxtDGpuName" Foreground="Yellow" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtDGpuTemp" Foreground="White" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDGpuLoad" Foreground="White" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDGpuClock" Foreground="Cyan" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDGpuVram" Foreground="Plum" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDGpuPower" Foreground="Orange" Margin="0,2"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Dahili GPU (iGPU)" BorderBrush="DodgerBlue" Foreground="White" Margin="0,10,0,0">
                                    <StackPanel Margin="10">
                                        <TextBlock x:Name="TxtIGpuName" Foreground="Yellow" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtIGpuLoad" Foreground="White"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Bellek ve Depolama" BorderBrush="Orange" Foreground="White" Margin="0,10,0,0">
                                    <StackPanel Margin="10">
                                        <TextBlock x:Name="TxtRamInfo" Foreground="Yellow"/>
                                        <ProgressBar x:Name="PbRam" Height="10" Margin="0,5" Maximum="100"/>
                                        <TextBlock x:Name="TxtDiskInfo" Foreground="White" Margin="0,10,0,0"/>
                                        <ProgressBar x:Name="PbDisk" Height="10" Margin="0,5" Maximum="100"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="GPU Test">
                            <local:GpuStressTest/>
                        </TabItem>
                        <TabItem Header="CPU Test">
                            <local:CpuStressTest/>
                        </TabItem>
                        <TabItem Header="Disk Test">
                            <local:DiskTestControl/>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
