<Window
    x:Class="HardwareMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HardwareMonitor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="Hardware Monitor">

    <Grid Background="#090909">

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="#111">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">

                <TextBlock Text="PC "
                           FontSize="18"
                           Foreground="White"/>

                <TextBlock Text="STATIX"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#00E5FF"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Margin="0,48,0,0">

            <muxc:TabView
                TabWidthMode="Equal"
                Background="Transparent">

                <!-- INFO TAB -->
                <muxc:TabViewItem Header="BİLGİ İZLEME">

                    <Grid Padding="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU PANEL -->
                        <Border Grid.Column="0"
                                CornerRadius="12"
                                Padding="20"
                                Background="#141414">

                            <StackPanel>

                                <TextBlock Text="İŞLEMCİ (CPU)"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#00E5FF"/>

                                <TextBlock x:Name="TxtCpuName"
                                           Text="--°C"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FF4444"
                                           Margin="0,10,0,10"/>

                                <TextBlock x:Name="TxtCpuTemp"
                                           Text="--°C"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FF4444"
                                           Margin="0,10,0,10"/>

                                <muxc:ItemsRepeater x:Name="IcCpuCores">
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"/>

                                                <ProgressBar Value="{Binding LoadValue}"
                                                             Maximum="100"
                                                             Height="6"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>

                            </StackPanel>
                        </Border>

                        <!-- RIGHT SIDE -->
                        <StackPanel Grid.Column="2"
                                    Spacing="15">

                            <!-- DGPU -->
                            <Border Background="#141414"
                                    CornerRadius="12"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="GRAFİK (GPU)"
                                               FontWeight="Bold"
                                               Foreground="#9D50BB"/>

                                    <TextBlock x:Name="TxtDGpuName"
                                               Text="--°C"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#C77DFF"/>

                                    <TextBlock x:Name="TxtDGpuTemp"
                                               Text="--°C"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#C77DFF"/>

                                    <TextBlock x:Name="TxtDGpuLoad"
           Text="--°C"
           FontSize="22"
           FontWeight="Bold"
           Foreground="#C77DFF"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtFps"
           Text="FPS: --"
           FontSize="18"
           FontWeight="Bold"
           Foreground="Lime"
           HorizontalAlignment="Right"
           Margin="0,10,20,0"/>


                            <!-- IGPU -->
                            <Border Background="#141414"
                         CornerRadius="6"
                         Padding="10">

                                <StackPanel>
                                    <TextBlock Text="GRAFİK (GPU)"
                                    FontWeight="Bold"
                                    Foreground="#9D50BB"/>

                                    <TextBlock x:Name="TxtIGpuName"
                                    Text="--°C"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#C77DFF"/>

                                    <TextBlock x:Name="TxtIGpuTemp"
                                    Text="--°C"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#C77DFF"/>

                                    <TextBlock x:Name="TxtIGpuLoad"
                       Text="--°C"
                   FontSize="22"
              FontWeight="Bold"
            Foreground="#C77DFF"/>
                                </StackPanel>
                            </Border>



                            <!-- RAM -->
                            <Border Background="#141414"
                                    CornerRadius="12"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="RAM BELLEK"
                                               FontWeight="Bold"
                                               Foreground="#00E5FF"/>

                                    <TextBlock x:Name="TxtRamInfo"
           FontWeight="Bold"
           Foreground="#00E5FF"/>

                                    <ProgressBar x:Name="PbRam"
                                                 Height="6"
                                                 Maximum="100"/>
                                </StackPanel>
                            </Border>

                            <!-- DISK -->
                            <Border Background="#141414"
                                    CornerRadius="12"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="DİSK (C:)"
                                               FontWeight="Bold"
                                               Foreground="#FFAA00"/>

                                    <TextBlock x:Name="TxtDiskInfo"
                      FontWeight="Bold"
                      Foreground="#00E5FF"/>

                                    <ProgressBar x:Name="PbDisk"
                                                 Height="6"
                                                 Maximum="100"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </muxc:TabViewItem>

                <!-- CPU TEST -->
                <muxc:TabViewItem Header="CPU TEST">
                    <local:CpuStressTest Width="600" Height="450"/>
                </muxc:TabViewItem>

            </muxc:TabView>

        </Grid>
    </Grid>
</Window>
