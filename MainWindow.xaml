<Window x:Class="DonanimBilgiWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donanım Bilgi Uygulaması"
        Width="600"
        Height="760"
        Background="#0F141E"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E3C78">
            <TextBlock Text="PCStatix"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20">

                <!-- CPU -->
                <Border Background="#191E2D" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="İşlemci Kullanımı" Foreground="Gray"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Border Height="18" Background="#2A2F45" CornerRadius="9">
                                <Border Width="{Binding CpuBarWidth}"
                                        Height="18"
                                        Background="#3282FF"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CpuUsageText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding CpuTempText}"
                                       Foreground="Orange"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Background="#191E2D" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="GPU" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Ekran Kartı Kullanımı" Foreground="Gray"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Border Height="18" Background="#2A2F45" CornerRadius="9">
                                <Border Width="{Binding GpuBarWidth}"
                                        Height="18"
                                        Background="#50C878"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding GpuUsageText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding GpuTempText}"
                                       Foreground="Orange"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Background="#191E2D" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="RAM" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Bellek Kullanımı" Foreground="Gray"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Border Height="18" Background="#2A2F45" CornerRadius="9">
                                <Border Width="{Binding RamBarWidth}"
                                        Height="18"
                                        Background="#B478FF"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding RamUsageText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RamTempText}"
                                       Foreground="Orange"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
