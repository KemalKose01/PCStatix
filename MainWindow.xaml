<Window x:Class="PCStatix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="PCStatix" Height="550" Width="900" Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <TextBlock Text="PC Statix"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

        <!-- Panel (StackPanel yerine WrapPanel veya Grid kullanabiliriz) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <!-- CPU Panel-->
            <Border Background="#1F1F1F" CornerRadius="10" Padding="20" Margin="10,0,10,0" Width="200">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="#00E5FF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="CpuTempText"
                               Text="-- °C"
                               Foreground="White"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Temperature"
                               Foreground="#AAAAAA"
                               FontSize="14" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- GPU Panel -->
            <Border Background="#1F1F1F" CornerRadius="10" Padding="20" Margin="10,0,10,0" Width="200">
                <StackPanel>
                    <TextBlock Text="GPU" Foreground="#FF9800" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="GpuTempText"
                               Text="-- °C"
                               Foreground="White"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Temperature"
                               Foreground="#AAAAAA"
                               FontSize="14" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Tablo ve Sensörler -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1F1F1F" CornerRadius="10" Margin="0,0,15,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Temperature History"
                               Foreground="White"
                               FontSize="16"
                               Margin="0 0 0 10"
                               FontWeight="Bold"/>
                    <Grid Background="#101010" Margin="5" >
                        <!-- Canlı Sensörler -->
                        <lvc:CartesianChart x:Name="TempChart"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1F1F1F" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Sensors"
                               Foreground="White"
                               FontSize="16"
                               Margin="0 0 0 10"
                               FontWeight="Bold"/>

                    <DataGrid x:Name="OtherSensorsDataGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#1F1F1F" Foreground="White" BorderThickness="0"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowBackground="#1E1E1E" AlternatingRowBackground="#151515">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
