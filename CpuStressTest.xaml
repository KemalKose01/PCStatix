<UserControl x:Class="HardwareMonitor.CpuStressTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="CPU Stres Testi" Foreground="#FFFF4500" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="#252525" CornerRadius="10" Padding="20" BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtCpuTemp" Text="--°C" FontSize="48" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCpuLoad" Text="Yük: %0" FontSize="18" Foreground="#95a5a6" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="CpuProgressBar" 
                         Height="10" 
                         Margin="0,30,0,5" 
                         Minimum="0" 
                         Maximum="20" 
                         Foreground="#f39c12" 
                         Background="#333" 
                         BorderThickness="0"/>
            <TextBlock x:Name="TxtCpuTimer" Text="Kalan Süre: 20s" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnStart" Content="Testi Başlat" Grid.Column="0" Height="40" Margin="5" Click="BtnStart_Click" Background="#27ae60" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="BtnStop" Content="Testi Durdur" Grid.Column="1" Height="40" Margin="5" Click="BtnStop_Click" IsEnabled="False" Background="#c0392b" Foreground="White" FontWeight="Bold"/>
            </Grid>

            <Border x:Name="CpuResultCard" Visibility="Collapsed" Background="#3327ae60" CornerRadius="8" Padding="15" Margin="0,20,0,0" BorderBrush="#27ae60" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TEST RAPORU" Foreground="#2ecc71" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtCpuFinalResult" Text="Maksimum Sıcaklık: -- | Test Durumu: --" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
