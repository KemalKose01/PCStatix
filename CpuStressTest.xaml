<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HardwareMonitor.CpuStressTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HardwareMonitor">

    <Page.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#27ae60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="20">

                <TextBlock Text="CPU STRES TESTİ"
                           Foreground="#3498db"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <!-- TEMP + LOAD -->
                <Border Background="#1e1e1e"
                        CornerRadius="15"
                        Padding="20">

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="İŞLEMCİ ISI"
                                       Foreground="#95a5a6"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtCpuTemp"
                                       Text="--°C"
                                       FontSize="42"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="İŞLEMCİ YÜKÜ"
                                       Foreground="#95a5a6"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtCpuLoad"
                                       Text="%--"
                                       FontSize="42"
                                       Foreground="#3498db"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PROGRESS -->
                <StackPanel>

                    <Grid>
                        <TextBlock Text="Test İlerlemesi"
                                   Foreground="#7f8c8d"
                                   FontSize="12"
                                   HorizontalAlignment="Left"/>

                        <TextBlock x:Name="TxtCpuTimer"
                                   Text="45s"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ProgressBar x:Name="CpuProgressBar"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="45"
                                 Background="#333"
                                 Foreground="#3498db"
                                 Margin="0,5,0,0"/>
                </StackPanel>

                <!-- RESULT CARD -->
                <Border x:Name="CpuResultCard"
                        Visibility="Collapsed"
                        Background="#1c2833"
                        BorderBrush="#34495e"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel Spacing="8">

                        <TextBlock Text="TEST RAPORU"
                                   Foreground="Gold"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtCpuNameResult"
                                   Foreground="White"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtCpuStatsResult"
                                   Foreground="#bdc3c7"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>

                        <Rectangle Height="1"
                                   Fill="#34495e"
                                   Margin="20,10"/>

                        <TextBlock x:Name="TxtCpuHealthResult"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- BUTTONS -->
                <Grid ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnStart"
                            Content="TESTİ BAŞLAT"
                            Click="BtnStart_Click"
                            Height="50"
                            FontSize="16"
                            FontWeight="Bold"
                            Style="{StaticResource ModernButton}"/>

                    <Button x:Name="BtnStop"
                            Grid.Column="1"
                            Content="TESTİ DURDUR"
                            Click="BtnStop_Click"
                            Height="50"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#c0392b"
                            CornerRadius="10"
                            IsEnabled="False"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
