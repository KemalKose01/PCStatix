<Page
    x:Class="HardwareMonitor.DiskStressTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="#121212">
        <StackPanel Margin="20">

            <TextBlock Text="DİSK OKUMA/YAZMA HIZI TESTİ"
                       Foreground="#FFAA00"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10"/>

            <TextBlock x:Name="TxtDiskHealth"
                       Text="Disk Durumu: Sağlıklı"
                       Foreground="Gray"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- LIVE SPEED CARD -->
            <Border Background="#1e1e1e"
                    CornerRadius="15"
                    Padding="20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="ANLIK YAZMA"
                                   Foreground="#95a5a6"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtLiveWrite"
                                   Text="0 MB/s"
                                   FontSize="32"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center">

                        <TextBlock Text="ANLIK OKUMA"
                                   Foreground="#95a5a6"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtLiveRead"
                                   Text="0 MB/s"
                                   FontSize="32"
                                   Foreground="#FFAA00"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RESULT CARD -->
            <Border Background="#1a1a1a"
                    CornerRadius="10"
                    Margin="0,20,0,0"
                    Padding="15"
                    BorderBrush="#333"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="TEST SONUCU (10GB)"
                               Foreground="DimGray"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="YAZMA SONUCU"
                                       Foreground="#7f8c8d"
                                       FontSize="10"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtFinalWrite"
                                       Text="-- MB/s"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OKUMA SONUCU"
                                       Foreground="#7f8c8d"
                                       FontSize="10"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtFinalRead"
                                       Text="-- MB/s"
                                       Foreground="#FFAA00"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- START BUTTON -->
            <StackPanel Margin="0,30">

                <Button x:Name="BtnStartTest"
                        Content="10GB TESTİ BAŞLAT"
                        Click="BtnStartTest_Click"
                        Height="40"
                        Background="#27ae60"
                        Style="{StaticResource ModernButton}"/>

                <ProgressBar x:Name="PbTestProgress"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Background="#333"
                             Foreground="#FFAA00"
                             BorderThickness="0"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
